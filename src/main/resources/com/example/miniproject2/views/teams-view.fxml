<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.miniproject2.controllers.teamsController"
            prefWidth="800" prefHeight="600">

    <!-- Top Header with Color and Title -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #3b5998; -fx-padding: 10;">
            <!-- Placeholder Image -->
            <ImageView fitHeight="50" fitWidth="50">
                <image>
                    <Image url="@/images/team_icon.png" preserveRatio="true"/>
                </image>
            </ImageView>

            <!-- Header Label -->
            <Label text="Team Management"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Center: TableView -->
    <center>
        <TableView fx:id="tableTeams" prefHeight="400" prefWidth="750" style="-fx-background-color: #f0f0f0;">
            <columns>
                <TableColumn fx:id="colName" text="Name" prefWidth="200"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="200"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="350"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom: Buttons -->
    <bottom>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #dfe3ee;">
            <Button fx:id="btnAdd" text="Add" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnEdit" text="Edit" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnDelete" text="Delete" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane><?xml version="1.0" encoding="UTF-8"?>

