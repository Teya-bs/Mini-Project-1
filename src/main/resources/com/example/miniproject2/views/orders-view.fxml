<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.miniproject2.controllers.OrdersController"
      spacing="20" prefWidth="900" prefHeight="550">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- LEFT: Form -->
    <VBox spacing="10" prefWidth="280">

        <Label text="Orders Management"
               style="-fx-font-size:18; -fx-font-weight:bold;"/>

        <Label text="Customer Name"/>
        <TextField fx:id="customerNameFld" promptText="e.g. Alice"/>

        <Label text="Product"/>
        <TextField fx:id="productFld" promptText="e.g. Laptop"/>

        <Label text="Quantity"/>
        <TextField fx:id="quantityFld" promptText="e.g. 2"/>

        <Label text="Unit Price"/>
        <TextField fx:id="unitPriceFld" promptText="e.g. 99.99"/>

        <Label text="Status"/>
        <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>

        <Text fx:id="errorMsg" style="-fx-fill: red;"/>

        <HBox spacing="8">
            <Button text="Insert" onAction="#addOrder"
                    style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>
            <Button text="Update" onAction="#updateOrder"
                    style="-fx-background-color:#2980b9; -fx-text-fill:white;"/>
            <Button text="Delete" onAction="#deleteOrder"
                    style="-fx-background-color:#c0392b; -fx-text-fill:white;"/>
        </HBox>

        <Button text="Clear" onAction="#clearFields" maxWidth="Infinity"/>

    </VBox>

    <!-- RIGHT: Table -->
    <TableView fx:id="ordersTable" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdCol"      text="ID"       prefWidth="50"/>
            <TableColumn fx:id="customerNameCol" text="Customer" prefWidth="130"/>
            <TableColumn fx:id="productCol"      text="Product"  prefWidth="120"/>
            <TableColumn fx:id="quantityCol"     text="Qty"      prefWidth="50"/>
            <TableColumn fx:id="unitPriceCol"    text="Price"    prefWidth="80"/>
            <TableColumn fx:id="statusCol"       text="Status"   prefWidth="100"/>
        </columns>
    </TableView>

</HBox>